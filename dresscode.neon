use:
	- nette
	- modernizations

paths:
	- src

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # constants published in upper case, where the case is part of the API
		paths: [src/Ftp.php]
		naming: {constant: keep}
